# Any OpenAI-compatible API works.
OPENAI_API_KEY=sk-your-key-here
# Leave OPENAI_BASE_URL empty for the official OpenAI API.
# Examples:
#   Ollama:    http://localhost:11434/v1   (with OPENAI_API_KEY=not-needed)
#   LM Studio: http://localhost:1234/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Shared secret required by the .NET app's X-API-Key header. Leave empty to disable
# auth for local dev; set the same value here and in RubricGuardian.Web (AiService:ApiKey /
# AiService__ApiKey) before exposing port 8000 beyond localhost.
AI_SERVICE_API_KEY=
