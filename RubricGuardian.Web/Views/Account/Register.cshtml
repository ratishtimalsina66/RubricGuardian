@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }

<div class="card card-white auth-card p-4">
    <div class="auth-eyebrow">RubricGuardian</div>
    <h1 class="h4 mb-1">Create your account</h1>
    <p class="text-muted small mb-4">Free for the MVP — one account per student.</p>

    <form method="post" action="/register">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Full name</label>
            <input asp-for="FullName" class="form-control" autocomplete="name" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button class="btn btn-primary w-100" type="submit">Create account</button>
    </form>

    <p class="text-muted small mt-3 mb-0">Already registered? <a href="/login">Sign in</a></p>
</div>
