@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }

<div class="card card-white auth-card p-4">
    <div class="auth-eyebrow">RubricGuardian</div>
    <h1 class="h4 mb-1">Sign in</h1>
    <p class="text-muted small mb-4">Check your assignment against the rubric before you submit.</p>

    <form method="post" action="/login">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <button class="btn btn-primary w-100" type="submit">Sign in</button>
    </form>

    <p class="text-muted small mt-3 mb-0">New here? <a href="/register">Create an account</a></p>
    <p class="text-muted small mt-2 mb-0">Demo login: <code>demo@rubricguardian.dev</code> / <code>Demo123!</code></p>
</div>
