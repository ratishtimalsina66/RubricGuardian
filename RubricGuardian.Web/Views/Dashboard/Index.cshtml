@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0">Welcome back, @Model.FullName.Split(' ')[0]</h1>
        <p class="text-muted mb-0">Here is where your assignments stand.</p>
    </div>
    <a class="btn btn-primary" href="/assignments/create">New assignment</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="card stat-card p-3">
            <div class="stat-value">@Model.CourseCount</div>
            <div class="stat-label">Courses</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card stat-card p-3">
            <div class="stat-value">@Model.AssignmentCount</div>
            <div class="stat-label">Assignments</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card stat-card p-3">
            <div class="stat-value">@Model.SubmissionCount</div>
            <div class="stat-label">Submissions checked</div>
        </div>
    </div>
</div>

<h2 class="h5 section-title">Recent assignments</h2>
@if (!Model.RecentAssignments.Any())
{
    <div class="card p-4 text-center text-muted">
        No assignments yet. <a href="/courses/create">Create a course</a>, then add your first assignment.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-rg mb-0">
            <thead>
                <tr>
                    <th>Assignment</th>
                    <th>Course</th>
                    <th>Due</th>
                    <th>Requirements</th>
                    <th>Latest version</th>
                    <th>Readiness</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var a in Model.RecentAssignments)
            {
                <tr>
                    <td><a href="/assignments/@a.AssignmentId" class="fw-semibold text-decoration-none">@a.Title</a></td>
                    <td class="text-muted">@a.CourseName</td>
                    <td class="text-muted">@(a.DueDate?.ToString("MMM d, yyyy") ?? "—")</td>
                    <td>@a.RequirementCount</td>
                    <td>@(a.LatestVersion is int v ? $"v{v}" : "—")</td>
                    <td>
                        @if (a.ReadinessPercent is double p)
                        {
                            <div class="progress" style="height: 8px; min-width: 90px;">
                                <div class="progress-bar" role="progressbar" style="width: @(p)%;" aria-valuenow="@p" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <span class="small text-muted">@p%</span>
                        }
                        else { <span class="text-muted">Not checked</span> }
                    </td>
                    <td><a href="/assignments/@a.AssignmentId/evaluation" class="small">View report</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
