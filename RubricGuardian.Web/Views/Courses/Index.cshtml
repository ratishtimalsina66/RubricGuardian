@model List<Course>
@{ ViewData["Title"] = "Courses"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Your courses</h1>
    <a class="btn btn-primary" href="/courses/create">Add course</a>
</div>

@if (!Model.Any())
{
    <div class="card p-4 text-center text-muted">
        No courses yet. Add your first course to start organizing assignments.
    </div>
}
else
{
    <div class="row g-3">
    @foreach (var course in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card p-3 h-100">
                <h2 class="h6 mb-1">@course.CourseName</h2>
                <div class="text-muted small mb-2">@course.Semester</div>
                <div class="text-muted small mb-3">@course.Assignments.Count assignment(s)</div>
                <a class="btn btn-outline-secondary btn-sm mt-auto" href="/assignments/create?courseId=@course.CourseId">Add assignment</a>
            </div>
        </div>
    }
    </div>
}
